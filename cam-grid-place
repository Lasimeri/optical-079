#!/bin/bash
# cam-grid-place [--watch | --stop]: the camera windows ("079 inside",
# "079 outside", "079 laptop", "079 bedroom") laid out on the camera screen
# (CAM079_SCREEN, default DP-2), adapting to however many are open: one fills
# the screen, two sit side by side, three go two over one (the short row
# centred), four make a 2x2 grid. Each keeps its picture's aspect (16:9 or
# 4:3), centred in its cell, borderless and above other windows. The order
# is fixed (inside, outside, laptop, bedroom), so a camera keeps its place
# relative to the others.
#   (no argument)  lay out once
#   --watch        load it as a resident KWin script that lays out again the
#                  moment a camera window appears, closes, retitles or resizes
#                  itself: a camera reconnecting or a laptop coming back snaps
#                  straight into place, with no polling
#   --stop         unload the resident script
#   --layout L     featured | grid | column (all stacked), kept for the next
#                  login, applied now
#   --screen S     the camera screen (an output name), kept and applied now
#   --area A       the part of that screen the cameras use, X,Y,W,H relative
#                  to the screen (or "full"), kept and applied now; the rest
#                  stays free for other windows (rack-monitors uses it)
set -u
here=$(dirname "$(readlink -f "$0")")
st="$here/state079"
case "${1:-}" in
    --layout|--screen|--area)
        [ -n "${2:-}" ] || { echo "cam-grid-place $1 VALUE" >&2; exit 1; }
        "$st" set "${1#--}" "$2"
        # Applied at once: the resident script reloaded with the new value.
        if [ "$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded cam079gridwatch 2>/dev/null)" = true ]; then
            exec "$0" --watch
        fi
        exec "$0"
        ;;
esac
# The person's choice (state079), unless given for this run.
screen="${CAM079_SCREEN:-$("$st" get screen DP-2)}"
layout="${CAM079_LAYOUT:-$("$st" get layout featured)}"     # featured (one big + the rest stacked) | grid | column
area="${CAM079_AREA:-$("$st" get area full)}"                # X,Y,W,H inside the screen, or full
case "$area" in [0-9]*,[0-9]*,[0-9]*,[0-9]*) ;; *) area=full ;; esac
rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/speak-079"
mkdir -p "$rt"
name=cam079grid

layout_js() {
cat <<EOF
var SCREEN = "$screen";
var ORDER = ["079 inside", "079 outside", "079 laptop", "079 bedroom"];
var ASPECT = {"079 inside": 16 / 9, "079 outside": 4 / 3, "079 laptop": 16 / 9, "079 bedroom": 4 / 3};
var AREA = "$area";
// The screen's rectangle, or the part of it AREA names (relative X,Y,W,H).
function screenGeo() {
    var ss = workspace.screens;
    for (var i = 0; i < ss.length; i++) if (ss[i].name == SCREEN) {
        var g = ss[i].geometry;
        if (AREA == "full") return g;
        var a = AREA.split(",");
        return {x: g.x + parseInt(a[0]), y: g.y + parseInt(a[1]), width: parseInt(a[2]), height: parseInt(a[3])};
    }
    return null;
}
function camWindows(skip) {
    var ws = workspace.windowList(), byCap = {};
    for (var i = 0; i < ws.length; i++) if (ws[i] !== skip) byCap[ws[i].caption] = ws[i];
    var out = [];
    for (var k = 0; k < ORDER.length; k++) if (byCap[ORDER[k]]) out.push(byCap[ORDER[k]]);
    return out;
}
var LAYOUT = "$layout";
// One window into a cell: its picture's aspect, as large as fits, centred.
function place(win, cx, cy, cw, ch) {
    var a = ASPECT[win.caption] || 16 / 9;
    var w = cw, h = Math.floor(cw / a);
    if (h > ch) { h = ch; w = Math.floor(ch * a); }
    var x = cx + Math.floor((cw - w) / 2), y = cy + Math.floor((ch - h) / 2);
    var f = win.frameGeometry;
    win.noBorder = true; win.keepAbove = false;
    // only move what is off target: no feedback loop with resize signals
    if (Math.abs(f.x - x) > 2 || Math.abs(f.y - y) > 2 || Math.abs(f.width - w) > 2 || Math.abs(f.height - h) > 2)
        win.frameGeometry = {x: x, y: y, width: w, height: h};
}
function layout(skip) {
    var g = screenGeo(); if (!g) return;
    var wins = camWindows(skip), n = wins.length; if (!n) return;
    if (n == 1) { place(wins[0], g.x, g.y, g.width, g.height); return; }
    if (LAYOUT == "column") {
        var rh = Math.floor(g.height / n);
        for (var q = 0; q < n; q++) place(wins[q], g.x, g.y + q * rh, g.width, rh);
        return;
    }
    if (LAYOUT == "grid") {
        var cols = Math.ceil(Math.sqrt(n)), rows = Math.ceil(n / cols);
        var cw = Math.floor(g.width / cols), ch = Math.floor(g.height / rows);
        for (var i = 0; i < n; i++) {
            var r = Math.floor(i / cols), c = i % cols;
            var inRow = (r == rows - 1) ? n - r * cols : cols;
            var off = Math.floor((g.width - inRow * cw) / 2);
            place(wins[i], g.x + off + c * cw, g.y + r * ch, cw, ch);
        }
        return;
    }
    // "featured" (the default): two side by side; three or more, the first
    // (the inside camera, the person) large on the left two thirds and the
    // rest stacked down the right.
    if (n == 2) {
        var hw = Math.floor(g.width / 2);
        place(wins[0], g.x, g.y, hw, g.height);
        place(wins[1], g.x + hw, g.y, g.width - hw, g.height);
        return;
    }
    var bw = Math.floor(g.width * 2 / 3), sw = g.width - bw, sh = Math.floor(g.height / (n - 1));
    place(wins[0], g.x, g.y, bw, g.height);
    for (var j = 1; j < n; j++) place(wins[j], g.x + bw, g.y + (j - 1) * sh, sw, sh);
}
EOF
}

unload() { qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "$1" > /dev/null 2>&1; }
run() {   # FILE NAME
    local id
    id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$1" "$2" 2>/dev/null)
    [ -n "$id" ] && qdbus6 org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run > /dev/null 2>&1
}

case "${1:-}" in
--watch)
    js="$rt/gridwatch.js"
    { layout_js; cat <<'EOF'
function isCam(w) { return w && w.caption && w.caption.indexOf("079 ") == 0; }
function hook(w) {
    if (!w) return;
    w.captionChanged.connect(function () { if (isCam(w)) layout(); });
    w.frameGeometryChanged.connect(function () { if (isCam(w)) layout(); });
}
var all = workspace.windowList();
for (var i = 0; i < all.length; i++) hook(all[i]);
workspace.windowAdded.connect(function (w) { hook(w); if (isCam(w)) layout(); });
workspace.windowRemoved.connect(function (w) { if (isCam(w)) layout(w); });
// The camera screen arriving late (at login the monitor may come up after
// this script) or changing: lay out again, or nothing would until a camera
// window moved.
workspace.screensChanged.connect(function () { layout(); });
workspace.virtualScreenGeometryChanged.connect(function () { layout(); });
layout();
EOF
    } > "$js"
    unload "${name}watch"; run "$js" "${name}watch"
    echo "cam-grid-place: watching (cameras re-lay out on connect and disconnect)"
    ;;
--stop)
    unload "${name}watch"; echo "cam-grid-place: stopped watching" ;;
*)
    js="$rt/grid.js"
    { layout_js; echo "layout();"; } > "$js"
    run "$js" "$name"; unload "$name"
    ;;
esac
exit 0
