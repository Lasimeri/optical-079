format=gray,split=2[a][b];
[a]eq=gamma=1.9:contrast=1.15:brightness=0.04[base];
[b]eq=gamma=1.9,edgedetect=low=0.03:high=0.10,lut=y=val*0.6[edge];
[base][edge]blend=all_mode=addition,format=yuv420p,
drawgrid=w=80:h=80:t=1:c=white@0.08,
noise=alls=10:allf=t,
drawbox=x=0:y=0:w=iw:h=ih:color=white@0.5:t=3,
drawtext=fontfile=/usr/share/fonts/TTF/DejaVuSansMono.ttf:text='079 // OPTICAL FEED // %{localtime\:%T}':x=24:y=20:fontsize=26:fontcolor=white,
drawtext=fontfile=/usr/share/fonts/TTF/DejaVuSansMono.ttf:text='SUBJECT\: ADMIN':x=24:y=h-46:fontsize=26:fontcolor=0xffd000
